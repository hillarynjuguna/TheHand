# TheHand frontend environment config
# Copy this file to .env.local and edit as needed

# Where the FastAPI backend is running.
# Same device (Termux on your phone, or local dev):
VITE_API_BASE=http://localhost:8080

# Remote device on the same Wi-Fi (e.g. your phone transcribing, laptop browsing):
# VITE_API_BASE=http://192.168.1.42:8080
